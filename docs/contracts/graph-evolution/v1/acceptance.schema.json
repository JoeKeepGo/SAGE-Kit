{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sagekit:graph-evolution:v1:acceptance",
  "title": "SAGE-Kit Graph Evolution Acceptance v1",
  "description": "A bounded external acceptance decision over one exact proposal and preauthorization digest. Acceptance records Project Manager authority and an independent evaluator decision. It is not execution and does not itself apply a target Graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "acceptance_id",
    "proposal_digest",
    "preauthorization_digest",
    "decision",
    "authority",
    "evaluator",
    "reason_code",
    "decision_refs"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:sagekit:graph-evolution:v1:acceptance"
    },
    "schema_version": {
      "const": 1
    },
    "acceptance_id": {
      "$ref": "#/$defs/reference"
    },
    "proposal_digest": {
      "$ref": "#/$defs/sha256"
    },
    "preauthorization_digest": {
      "$ref": "#/$defs/sha256"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_role",
        "authority_ref"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "authority_role": {
          "const": "PROJECT_MANAGER"
        },
        "authority_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "role",
        "decision",
        "decision_ref"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "role": {
          "$ref": "#/$defs/opaque_id"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "decision_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "reason_code": {
      "enum": [
        "OBSERVED_FAILURE",
        "VERIFICATION_GAP",
        "BLOCKING_UNCERTAINTY",
        "NODE_TOO_BROAD",
        "OPTIONAL_NODE_NO_LONGER_DECISIVE",
        "EXISTING_GRAPH_SUFFICIENT",
        "NO_PROGRESS",
        "AUTHORITY_CHANGE_REQUIRED",
        "WITHIN_PREAUTHORIZATION",
        "EVALUATOR_REJECTED",
        "BUDGET_EXHAUSTED",
        "CONTRACT_CHANGED"
      ]
    },
    "decision_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "evaluator": {
            "properties": {
              "decision": {
                "const": "APPROVE"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evaluator": {
            "properties": {
              "decision": {
                "const": "REJECT"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!(?:file|https?|unc):)[^\\r\\n\\\\]+$"
    }
  }
}
