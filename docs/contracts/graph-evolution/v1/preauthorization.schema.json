{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sagekit:graph-evolution:v1:preauthorization",
  "title": "SAGE-Kit Graph Evolution PM Preauthorization v1",
  "description": "A closed Project Manager preauthorization envelope. Every operation, change class, node, role, permission, path, generation budget, operation budget, independent evaluator, stop condition, and authority value is explicit and bounded. Omission never means allow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "preauthorization_id",
    "graph_id",
    "parent_generation",
    "parent_graph_digest",
    "authority",
    "allowed_operations",
    "allowed_change_classes",
    "allowed_node_ids",
    "allowed_roles",
    "allowed_permissions",
    "allowed_paths",
    "generation_budget",
    "operation_budgets",
    "evaluator",
    "stop_conditions"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:sagekit:graph-evolution:v1:preauthorization"
    },
    "schema_version": {
      "const": 1
    },
    "preauthorization_id": {
      "$ref": "#/$defs/reference"
    },
    "graph_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "parent_generation": {
      "type": "integer",
      "minimum": 1
    },
    "parent_graph_digest": {
      "$ref": "#/$defs/sha256"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_role",
        "authority_ref"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "authority_role": {
          "const": "PROJECT_MANAGER"
        },
        "authority_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ADD_CORRECTIVE",
          "ADD_VERIFICATION",
          "ADD_INVESTIGATION",
          "SPLIT_PENDING",
          "DISABLE_OPTIONAL_PENDING",
          "NO_CHANGE"
        ]
      }
    },
    "allowed_change_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "C0",
          "C1",
          "C2",
          "C3"
        ]
      }
    },
    "allowed_node_ids": {
      "$ref": "#/$defs/identity_allowlist"
    },
    "allowed_roles": {
      "$ref": "#/$defs/identity_allowlist"
    },
    "allowed_permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "READ_ONLY_REVIEW",
          "WRITE_AUTHORIZED",
          "CORRECTIVE_AUTHORIZED",
          "ENVIRONMENT_WRITE_AUTHORIZED",
          "SUBMIT_AUTHORIZED"
        ]
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path_pattern"
      }
    },
    "generation_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_target_generation",
        "remaining_generations"
      ],
      "properties": {
        "max_target_generation": {
          "type": "integer",
          "minimum": 2
        },
        "remaining_generations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "operation_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ADD_CORRECTIVE",
        "ADD_VERIFICATION",
        "ADD_INVESTIGATION",
        "SPLIT_PENDING",
        "DISABLE_OPTIONAL_PENDING",
        "NO_CHANGE"
      ],
      "properties": {
        "ADD_CORRECTIVE": {
          "$ref": "#/$defs/operation_budget"
        },
        "ADD_VERIFICATION": {
          "$ref": "#/$defs/operation_budget"
        },
        "ADD_INVESTIGATION": {
          "$ref": "#/$defs/operation_budget"
        },
        "SPLIT_PENDING": {
          "$ref": "#/$defs/operation_budget"
        },
        "DISABLE_OPTIONAL_PENDING": {
          "$ref": "#/$defs/operation_budget"
        },
        "NO_CHANGE": {
          "$ref": "#/$defs/operation_budget"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "role",
        "permission",
        "authority_ref",
        "independent"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "role": {
          "$ref": "#/$defs/opaque_id"
        },
        "permission": {
          "enum": [
            "READ_ONLY_REVIEW",
            "WRITE_AUTHORIZED",
            "CORRECTIVE_AUTHORIZED",
            "ENVIRONMENT_WRITE_AUTHORIZED",
            "SUBMIT_AUTHORIZED"
          ]
        },
        "authority_ref": {
          "$ref": "#/$defs/reference"
        },
        "independent": {
          "const": true
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "BUDGET_EXHAUSTED",
          "NO_PROGRESS",
          "EVALUATOR_REJECTED",
          "AUTHORITY_CHANGED",
          "CONTRACT_CHANGED",
          "PERMISSION_EXPANSION",
          "GATE_OR_VERIFIER_REMOVAL"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_budget": {
            "properties": {
              "remaining_generations": {
                "const": 0
              }
            },
            "required": [
              "remaining_generations"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_CORRECTIVE": {
                "const": 0
              },
              "ADD_VERIFICATION": {
                "const": 0
              },
              "ADD_INVESTIGATION": {
                "const": 0
              },
              "SPLIT_PENDING": {
                "const": 0
              },
              "DISABLE_OPTIONAL_PENDING": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "ADD_CORRECTIVE"
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_CORRECTIVE": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_CORRECTIVE": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "ADD_VERIFICATION"
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_VERIFICATION": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_VERIFICATION": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "ADD_INVESTIGATION"
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_INVESTIGATION": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "ADD_INVESTIGATION": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "SPLIT_PENDING"
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "SPLIT_PENDING": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "SPLIT_PENDING": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "DISABLE_OPTIONAL_PENDING"
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "DISABLE_OPTIONAL_PENDING": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "DISABLE_OPTIONAL_PENDING": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "NO_CHANGE"
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "NO_CHANGE": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation_budgets": {
            "properties": {
              "NO_CHANGE": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\r\\n\\\\]+$"
    },
    "path_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?:[^/\\r\\n\\\\*]+|\\*|\\*\\*)(?:/(?:[^/\\r\\n\\\\*]+|\\*|\\*\\*))*$"
    },
    "identity_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/opaque_id"
      }
    },
    "operation_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
