{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sagekit:graph-evolution:v1:request",
  "title": "SAGE-Kit Graph Evolution Request v1",
  "description": "A bounded request to consider one named Graph evolution operation. It binds the current Graph identity, external authority, proposer, subject node, change class, machine reason, evidence and decision references, affected repository-relative paths, and an externally supplied Stage 5 lineage digest. It grants no authority and performs no work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "request_id",
    "operation",
    "graph_id",
    "parent_generation",
    "parent_graph_digest",
    "authority",
    "proposer",
    "node_id",
    "change_class",
    "reason_code",
    "evidence_refs",
    "decision_refs",
    "affected_paths",
    "stage5_lineage_digest"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:sagekit:graph-evolution:v1:request"
    },
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/reference"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "graph_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "parent_generation": {
      "$ref": "#/$defs/generation"
    },
    "parent_graph_digest": {
      "$ref": "#/$defs/sha256"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "proposer": {
      "$ref": "#/$defs/proposer"
    },
    "node_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "change_class": {
      "$ref": "#/$defs/change_class"
    },
    "reason_code": {
      "$ref": "#/$defs/reason_code"
    },
    "finding_ref": {
      "$ref": "#/$defs/reference",
      "description": "Required only for ADD_CORRECTIVE; binds the observed finding without dereferencing it."
    },
    "root_cause_ref": {
      "$ref": "#/$defs/reference",
      "description": "Required only for ADD_CORRECTIVE; binds the accepted root-cause record without dereferencing it."
    },
    "subject_status": {
      "const": "PENDING",
      "description": "Required only for SPLIT_PENDING and DISABLE_OPTIONAL_PENDING. This digest-bound assertion does not create runtime state."
    },
    "evidence_refs": {
      "$ref": "#/$defs/references"
    },
    "decision_refs": {
      "$ref": "#/$defs/references"
    },
    "affected_paths": {
      "$ref": "#/$defs/paths"
    },
    "stage5_lineage_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Digest of the externally retained Stage 5 lineage record selected by its owner. This contract binds the supplied value and does not redefine Stage 5 lineage semantics."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ADD_CORRECTIVE"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "finding_ref",
          "root_cause_ref"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "finding_ref"
              ]
            },
            {
              "required": [
                "root_cause_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "SPLIT_PENDING",
              "DISABLE_OPTIONAL_PENDING"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "subject_status"
        ]
      },
      "else": {
        "not": {
          "required": [
            "subject_status"
          ]
        }
      }
    }
  ],
  "$defs": {
    "operation": {
      "type": "string",
      "enum": [
        "ADD_CORRECTIVE",
        "ADD_VERIFICATION",
        "ADD_INVESTIGATION",
        "SPLIT_PENDING",
        "DISABLE_OPTIONAL_PENDING",
        "NO_CHANGE"
      ]
    },
    "change_class": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "permission": {
      "type": "string",
      "enum": [
        "READ_ONLY_REVIEW",
        "WRITE_AUTHORIZED",
        "CORRECTIVE_AUTHORIZED",
        "ENVIRONMENT_WRITE_AUTHORIZED",
        "SUBMIT_AUTHORIZED"
      ]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "OBSERVED_FAILURE",
        "VERIFICATION_GAP",
        "BLOCKING_UNCERTAINTY",
        "NODE_TOO_BROAD",
        "OPTIONAL_NODE_NO_LONGER_DECISIVE",
        "EXISTING_GRAPH_SUFFICIENT",
        "NO_PROGRESS",
        "AUTHORITY_CHANGE_REQUIRED",
        "WITHIN_PREAUTHORIZATION",
        "EVALUATOR_REJECTED",
        "BUDGET_EXHAUSTED",
        "CONTRACT_CHANGED"
      ]
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\r\\n\\\\]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[^/\\r\\n\\\\*]+(?:/[^/\\r\\n\\\\*]+)*$"
    },
    "references": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_role",
        "authority_ref"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "authority_role": {
          "$ref": "#/$defs/opaque_id"
        },
        "authority_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "role",
        "permission"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "role": {
          "$ref": "#/$defs/opaque_id"
        },
        "permission": {
          "$ref": "#/$defs/permission"
        }
      }
    }
  }
}
