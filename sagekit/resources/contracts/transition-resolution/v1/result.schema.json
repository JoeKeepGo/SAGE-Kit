{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sagekit:transition-resolution:v1:result",
  "title": "SAGE-Kit Transition Resolution Result v1",
  "description": "A closed, language-neutral pure transition decision limited to 16777216 canonical bytes under contract.json. It is valid only for the exact bound input and Node Result digests and expresses only a transition allowed by the existing Stage 2B validate_node_transition owner. It is not a Runtime Event, state write, lease, execution packet, gate decision, Graph mutation, or authority grant. The host/runtime writer must revalidate every snapshot binding before apply and must reject this Result if any bound value changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "disposition",
    "input_digest",
    "node_result_digest",
    "graph_id",
    "graph_generation",
    "graph_digest",
    "run_id",
    "authority_id",
    "controller_id",
    "node_id",
    "attempt_id",
    "state_revision",
    "last_event_sequence",
    "previous_status",
    "next_status",
    "reason_code",
    "transition_allowed",
    "authority_decision_required",
    "grants_execution_authority",
    "grants_graph_mutation_authority",
    "grants_gate_authority",
    "grants_write_authority"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:sagekit:transition-resolution:v1:result"
    },
    "schema_version": {
      "const": 1
    },
    "disposition": {
      "type": "string",
      "enum": [
        "APPLY_TRANSITION",
        "APPLY_HANDOFF_AND_REQUEST_AUTHORITY"
      ]
    },
    "input_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Domain-separated digest of the complete validated transition input."
    },
    "node_result_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Domain-separated canonical content digest of the complete existing Node Result v1 instance."
    },
    "graph_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "graph_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "graph_digest": {
      "$ref": "#/$defs/sha256"
    },
    "run_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "authority_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "controller_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "node_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "state_revision": {
      "$ref": "#/$defs/nonnegative_sequence"
    },
    "last_event_sequence": {
      "$ref": "#/$defs/nonnegative_sequence"
    },
    "previous_status": {
      "$ref": "#/$defs/node_status"
    },
    "next_status": {
      "$ref": "#/$defs/node_status",
      "description": "The Node Result proposed status preserved exactly; NO_ACTION_REQUIRED and DONE_WITH_CONCERNS are never mapped to SUCCEEDED."
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "NODE_RESULT_STATUS_APPLIED",
        "AUTHORITY_CHANGE_HANDOFF_REQUIRED"
      ]
    },
    "transition_allowed": {
      "const": true
    },
    "authority_decision_required": {
      "type": "boolean"
    },
    "grants_execution_authority": {
      "const": false
    },
    "grants_graph_mutation_authority": {
      "const": false
    },
    "grants_gate_authority": {
      "const": false
    },
    "grants_write_authority": {
      "const": false
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque non-empty identity preserved exactly within the aggregate byte budget."
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "node_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "WAITING_RESOURCE",
        "SUCCEEDED",
        "NO_ACTION_REQUIRED",
        "FAILED",
        "NEEDS_CORRECTION",
        "HANDOFF",
        "BLOCKED",
        "CANCELLED",
        "DONE_WITH_CONCERNS"
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "previous_status": {
              "const": "PENDING"
            },
            "next_status": {
              "enum": [
                "READY",
                "HANDOFF",
                "BLOCKED",
                "CANCELLED"
              ]
            }
          }
        },
        {
          "properties": {
            "previous_status": {
              "const": "READY"
            },
            "next_status": {
              "enum": [
                "RUNNING",
                "WAITING_RESOURCE",
                "HANDOFF",
                "BLOCKED",
                "CANCELLED"
              ]
            }
          }
        },
        {
          "properties": {
            "previous_status": {
              "const": "RUNNING"
            },
            "next_status": {
              "enum": [
                "WAITING_RESOURCE",
                "SUCCEEDED",
                "NO_ACTION_REQUIRED",
                "FAILED",
                "NEEDS_CORRECTION",
                "HANDOFF",
                "BLOCKED",
                "CANCELLED",
                "DONE_WITH_CONCERNS"
              ]
            }
          }
        },
        {
          "properties": {
            "previous_status": {
              "const": "WAITING_RESOURCE"
            },
            "next_status": {
              "enum": [
                "READY",
                "RUNNING",
                "HANDOFF",
                "BLOCKED",
                "CANCELLED"
              ]
            }
          }
        },
        {
          "properties": {
            "previous_status": {
              "const": "NEEDS_CORRECTION"
            },
            "next_status": {
              "enum": [
                "READY",
                "HANDOFF",
                "BLOCKED",
                "CANCELLED"
              ]
            }
          }
        }
      ]
    },
    {
      "if": {
        "required": [
          "disposition"
        ],
        "properties": {
          "disposition": {
            "const": "APPLY_HANDOFF_AND_REQUEST_AUTHORITY"
          }
        }
      },
      "then": {
        "properties": {
          "next_status": {
            "const": "HANDOFF"
          },
          "reason_code": {
            "const": "AUTHORITY_CHANGE_HANDOFF_REQUIRED"
          },
          "authority_decision_required": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "reason_code": {
            "const": "NODE_RESULT_STATUS_APPLIED"
          },
          "authority_decision_required": {
            "const": false
          }
        }
      }
    }
  ]
}
